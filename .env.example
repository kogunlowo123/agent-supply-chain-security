# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
SERVICE_PORT=8000

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_SBOM=your-sbom-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/supply_chain_security

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me

# LLM
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
LLM_MODEL=vertex_ai/gemini-1.5-pro

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu

# Security
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=RS256

# Sigstore
SIGSTORE_REKOR_URL=https://rekor.sigstore.dev
SIGSTORE_FULCIO_URL=https://fulcio.sigstore.dev
COSIGN_REPOSITORY=us-central1-docker.pkg.dev/your-project/supply-chain

# OSV/NVD
OSV_API_URL=https://api.osv.dev/v1
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=your-nvd-api-key

# Pub/Sub
PUBSUB_TOPIC_SBOM_CREATED=sbom-created
PUBSUB_TOPIC_PROVENANCE_FAILED=provenance-failed
PUBSUB_TOPIC_VULNERABILITY_FOUND=vulnerability-found

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-supply-chain-security
